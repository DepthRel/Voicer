{
  // Each build task builds one project with "dotnet build <csproj>": MSBuild compiles only that project and its
  // ProjectReference closure.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: UI",
      "detail": "Voicer.UI (Avalonia) and its dependencies",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Sources/Apps/Voicer.UI/Voicer.UI.csproj",
        "-nologo",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: solution",
      "detail": "Every project of Voicer.slnx",
      "type": "process",
      "command": "dotnet",
      "args": [ "build", "${workspaceFolder}/Voicer.slnx", "-nologo", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary;ForceNoAlign" ],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: solution",
      "detail": "Every test project",
      "type": "process",
      "command": "dotnet",
      "args": [ "test", "${workspaceFolder}/Voicer.slnx", "-nologo" ],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
