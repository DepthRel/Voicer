<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The dark palette of Voicer: the palette of RCynQ with more light. The accent glows around primary buttons, the
    selected tab, progress and a file dragged over the drop area, and the window carries a faint blue-violet halo.
  -->
  <Color x:Key="WindowBackgroundColor">#1B1D21</Color>
  <Color x:Key="NavBackgroundColor">#202328</Color>
  <Color x:Key="CardBackgroundColor">#22252A</Color>
  <Color x:Key="InputBackgroundColor">#25282E</Color>
  <Color x:Key="HoverBackgroundColor">#2C3036</Color>
  <Color x:Key="PressedBackgroundColor">#33373E</Color>
  <Color x:Key="DividerColor">#2F333A</Color>
  <Color x:Key="BorderColor">#3A3F47</Color>
  <Color x:Key="BorderHoverColor">#4B515A</Color>
  <Color x:Key="AccentColor">#4A8FF7</Color>
  <Color x:Key="AccentHoverColor">#62A0FA</Color>
  <Color x:Key="AccentPressedColor">#3A7BE0</Color>
  <Color x:Key="TextPrimaryColor">#E6E8EB</Color>
  <Color x:Key="TextSecondaryColor">#A0A6AE</Color>
  <Color x:Key="TextMutedColor">#737A83</Color>
  <Color x:Key="SuccessColor">#3FB950</Color>
  <Color x:Key="WarningColor">#D29922</Color>
  <Color x:Key="DangerColor">#F85149</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
  <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentColor}" Opacity="0.14" />
  <!-- The ground of the phrase being said: strong enough to follow at a glance while the sound plays. -->
  <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentColor}" Opacity="0.42" />
  <SolidColorBrush x:Key="AccentFaintBrush" Color="{StaticResource AccentColor}" Opacity="0.06" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />

  <!-- Fluent accent overrides so built-in controls (selection, focus, check marks) use the accent blue. -->
  <Color x:Key="SystemAccentColor">#4A8FF7</Color>
  <Color x:Key="SystemAccentColorDark1">#3A7BE0</Color>
  <Color x:Key="SystemAccentColorDark2">#2F68C4</Color>
  <Color x:Key="SystemAccentColorDark3">#2556A6</Color>
  <Color x:Key="SystemAccentColorLight1">#62A0FA</Color>
  <Color x:Key="SystemAccentColorLight2">#7DB1FB</Color>
  <Color x:Key="SystemAccentColorLight3">#A3C8FD</Color>

  <!-- The colours of the logo (Assets/voicer.svg): violet at the top of the wave, blue at the bottom. -->
  <SolidColorBrush x:Key="BrandBlueBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="BrandVioletBrush" Color="#C084FC" />
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#C084FC" />
    <GradientStop Offset="1" Color="#4A8FF7" />
  </LinearGradientBrush>

  <!--
    The main button of a page: two gradients of the colours of the logo, running in opposite directions; the upper one
    fades in and out, so the colours flow from one side to the other.
  -->
  <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="#4A8FF7" />
    <GradientStop Offset="0.5" Color="#8B7CF8" />
    <GradientStop Offset="1" Color="#C084FC" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroShimmerBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="#C084FC" />
    <GradientStop Offset="0.5" Color="#8B7CF8" />
    <GradientStop Offset="1" Color="#4A8FF7" />
  </LinearGradientBrush>

  <!-- The light: soft halos of the accent, from a hint to the glow of an element in focus. -->
  <BoxShadows x:Key="GlowSoft">0 0 14 0 #594A8FF7</BoxShadows>
  <BoxShadows x:Key="GlowStrong">0 0 22 2 #8C4A8FF7</BoxShadows>
  <BoxShadows x:Key="GlowLine">0 0 10 1 #CC4A8FF7</BoxShadows>
  <BoxShadows x:Key="CardShadow">0 6 24 0 #40000000</BoxShadows>

  <!-- The halo of the window: a faint blue-violet light from the top. -->
  <RadialGradientBrush x:Key="WindowHaloBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="70%" RadiusY="60%">
    <GradientStop Offset="0" Color="#264A8FF7" />
    <GradientStop Offset="0.55" Color="#0DA06CF0" />
    <GradientStop Offset="1" Color="#00000000" />
  </RadialGradientBrush>

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Menlo, monospace</FontFamily>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">10</CornerRadius>

</ResourceDictionary>
