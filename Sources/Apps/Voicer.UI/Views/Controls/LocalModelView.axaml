<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Voicer.UI.Localization"
             xmlns:items="using:Voicer.UI.ViewModels.Items"
             xmlns:dialogs="using:Voicer.UI.ViewModels.Dialogs"
             xmlns:controls="using:Voicer.UI.Controls"
             x:Class="Voicer.UI.Views.Controls.LocalModelView"
             x:DataType="items:ModelSourceSettingsViewModel">
  <!-- A model of Voicer: its catalog, and the llama-server that runs it while it is needed, with its stop. -->
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="*,Auto" DataContext="{Binding Catalog}" x:DataType="dialogs:ModelCatalogViewModel">
      <TextBlock Classes="muted" Classes.success="{Binding HasInstalled}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Summary}" />
      <Button Grid.Column="1" Classes="outline" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding OpenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:IconView Classes="small" IconKey="Icon.Model" />
          <TextBlock Text="{loc:Loc Models.Choose}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" DataContext="{Binding LocalServer}" x:DataType="items:LlamaServerViewModel">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsActive}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding StateText}" />
        </StackPanel>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UsageText}" IsVisible="{Binding HasUsage}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="outline" VerticalAlignment="Center" Margin="12,0,0,0"
              Command="{Binding StopCommand}" IsVisible="{Binding IsActive}"
              ToolTip.Tip="{loc:Loc LlamaServer.StopHint}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:IconView Classes="small" IconKey="Icon.Stop" />
          <TextBlock Text="{loc:Loc LlamaServer.Stop}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
