<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Text to speech with llama.cpp (MIT): the pinned build of llama.cpp the application downloads into the tools folder,
    and the voice of a text spoken by its llama-tts program. Every piece of text runs in a process of its own, started
    without a shell, so the model leaves memory as soon as the piece is spoken and a native failure of a video driver
    ends only that process.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Voicer.Core\Voicer.Core.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Voicer.Downloads\Voicer.Downloads.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Voicer.Speech.Llama.Tests" />
  </ItemGroup>

</Project>
